import Mathlib.Data.Real.Basic
import Mathlib.Tactic.Linarith
import Mathlib.Tactic.Ring

namespace UnsoftenedNBody.FultonMacPhersonSplitting.SynchronousSupernodes

/-- Cluster compactness predicate defining the activation of a synchronous supernode.
    A sub-cluster of cardinality k ≥ 3 enters the compact quasi-collision regime
    whenever its internal hyper-radius falls below the threshold δ_cluster > 0. -/
def isCompactCluster (rho : ℝ) (delta_cluster : ℝ) : Prop :=
  rho ≤ delta_cluster

/-- Local physical time increment generated by the unfolded Sundman clock
    of the unified supernode under flow speed χ_S² = ρ_S (Definition 4.4):
    Δt_S(ρ_S, Δτ_S) = χ_S² · Δτ_S = ρ_S · Δτ_S.
    In direct quadratic algebraic formulation:
    (Δt_S)² = χ_S⁴ · (Δτ_S)² = ρ_S² · (Δτ_S)². -/
noncomputable def superNodePhysicalTimeStepSq (rho : ℝ) (dtau : ℝ) : ℝ :=
  (rho * rho) * (dtau * dtau)

/-- Theorem: Strict positivity of the supernode physical time increment.
    For a strictly positive internal hyper-radius (ρ_S > 0) and a positive regularized step (Δτ_S > 0),
    the square of the physical time increment is strictly positive: (Δt_S)² > 0,
    precluding any Zeno-type time freezing inside the supernode. -/
theorem super_node_time_step_sq_pos (rho : ℝ) (dtau : ℝ)
    (h_rho : 0 < rho) (h_tau : 0 < dtau) :
    0 < superNodePhysicalTimeStepSq rho dtau := by
  dsimp [superNodePhysicalTimeStepSq]
  have h_r2 : 0 < rho * rho := mul_pos h_rho h_rho
  have h_t2 : 0 < dtau * dtau := mul_pos h_tau h_tau
  exact mul_pos h_r2 h_t2

/-- Theorem: Cumulative Anti-Zeno property of the synchronous supernode.
    For any number of regularized sub-steps N ≥ 1, the accumulated physical time is strictly
    positive, ensuring that the integration of the supernode progresses forward. -/
theorem super_node_accumulated_time_sq_pos (rho : ℝ) (dtau : ℝ)
    (h_rho : 0 < rho) (h_tau : 0 < dtau) (N : Nat) (hN : 1 ≤ N) :
    0 < (N : ℝ) * (N : ℝ) * superNodePhysicalTimeStepSq rho dtau := by
  have h_step := super_node_time_step_sq_pos rho dtau h_rho h_tau
  have hN_pos : (0 : ℝ) < (N : ℝ) := by
    have h_lt : 0 < N := Nat.lt_of_lt_of_le Nat.zero_lt_one hN
    exact Nat.cast_pos.mpr h_lt
  have hN2_pos : 0 < (N : ℝ) * (N : ℝ) := mul_pos hN_pos hN_pos
  exact mul_pos hN2_pos h_step

end UnsoftenedNBody.FultonMacPhersonSplitting.SynchronousSupernodes
